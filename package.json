{
  "name": "omp-resume",
  "private": true,
  "version": "0.7.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run superagent:build && tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "typecheck": "npm run superagent:build && tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "check": "npm run typecheck && vitest run && npm run superagent:typecheck && npm run superagent:test",
    "superagent:build": "npm -w omp-superagent run build",
    "superagent:typecheck": "npm -w omp-superagent run typecheck",
    "superagent:test": "npm -w omp-superagent run test"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.3",
    "lucide-react": "1.61.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^27",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5"
  },
  "workspaces": [
    "superagent"
  ]
}
